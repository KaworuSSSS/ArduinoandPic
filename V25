  // READ
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("================================"));
  Serial.println(F("ETAPA 6: FLASH READ"));
  Serial.println(F("================================"));

  dump32(address);

  // ------------------------------------------------------
  // VERIFY
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("================================"));
  Serial.println(F("ETAPA 7: VERIFICACION"));
  Serial.println(F("================================"));

  verifyWord(address, word);

  exitLVP();

  Serial.println();
  Serial.println(F("================================"));
  Serial.println(F("PROCESO V25 TERMINADO"));
  Serial.println(F("================================"));

  Serial.println(F("Comandos:"));
