// ========================================================
// WRITE PERSONALIZADO
// ========================================================

void writeCustom(uint32_t address,
                 uint16_t word)
{
  Serial.println();
  Serial.println(F("########################################"));
  Serial.println(F(" V25 WRITE PERSONALIZADO"));
  Serial.println(F("########################################"));

  Serial.print(F("DIRECCION = "));
  printHex24(address);
  Serial.println();

  Serial.print(F("DATO      = 0x"));
  printHex16(word);
  Serial.println();

  if ((address & 0x0F) != 0)
  {
    Serial.println();
    Serial.println(F("ERROR: direccion no alineada"));
    Serial.println(F("La direccion debe terminar en 0"));
    return;
  }

  enterLVP();

  // ------------------------------------------------------
  // DEVICE ID
  // ------------------------------------------------------

  uint16_t id = readDeviceID();

  if (id != 0x1207)
  {
    Serial.println(F("ERROR: DEVICE ID INCORRECTO"));
    exitLVP();
    return;
  }

  Serial.println(F("DEVICE ID: OK"));

  // ------------------------------------------------------
  // ERASE
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("ETAPA 2: ERASE"));

  eraseAll();

  uint8_t erased =
    readFlash(0x00, 0x00, 0x00);

  if (erased != 0xFF)
  {
    Serial.println(F("ERROR: ERASE VERIFY FALLA"));
    exitLVP();
    return;
  }

  Serial.println(F("ERASE VERIFY: OK"));

  // ------------------------------------------------------
  // BUFFER
  // ------------------------------------------------------

  nullBuffer();

  buffer[0] = word & 0xFF;
  buffer[1] = (word >> 8) & 0xFF;

  Serial.println();
  Serial.println(F("ETAPA 3: BUFFER"));

  printBuffer();

  // ------------------------------------------------------
  // LOAD
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("ETAPA 4: LOAD WRITE BUFFER"));

  loadWriteBuffer(address);

  // ------------------------------------------------------
  // PROGRAM
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("ETAPA 5: PROGRAM FLASH"));

  programFlash();

  // ------------------------------------------------------
  // READ
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("ETAPA 6: FLASH READ"));

  dump32(address);

  // ------------------------------------------------------
  // VERIFY
  // ------------------------------------------------------

  Serial.println();
  Serial.println(F("ETAPA 7: VERIFY"));

  verifyWord(address, word);

  exitLVP();

  Serial.println();
  Serial.println(F("V25 WRITE TERMINADO"));
}

// ========================================================
// READ COMMAND
// ========================================================

void readCustom(uint32_t address)
{
  Serial.println();
  Serial.println(F("########################################"));
  Serial.println(F(" V25 READ"));
  Serial.println(F("########################################"));

  Serial.print(F("DIRECCION = "));
  printHex24(address);
  Serial.println();

  enterLVP();

  uint16_t id = readDeviceID();

  if (id != 0x1207)
  {
    Serial.println(F("DEVICE ID INCORRECTO"));
    exitLVP();
    return;
  }

  uint8_t lo =
    readFlash(
      (address >> 16) & 0xFF,
      (address >> 8) & 0xFF,
      address & 0xFF
    );

  uint32_t a1 = address + 1;

  uint8_t hi =
    readFlash(
      (a1 >> 16) & 0xFF,
      (a1 >> 8) & 0xFF,
      a1 & 0xFF
    );

  uint16_t value =
    ((uint16_t)hi << 8) | lo;

  Serial.println();
  Serial.println(F("RESULTADO"));

  Serial.print(F("LOW  = 0x"));
  printHex8(lo);
  Serial.println();

  Serial.print(F("HIGH = 0x"));
  printHex8(hi);
  Serial.println();

  Serial.print(F("WORD = 0x"));
  printHex16(value);
  Serial.println();

  exitLVP();
}

