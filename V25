// ========================================================
// ERASE COMMAND
// ========================================================

void commandErase()
{
  enterLVP();

  uint16_t id = readDeviceID();

  if (id != 0x1207)
  {
    Serial.println(F("DEVICE ID INCORRECTO"));
    exitLVP();
    return;
  }

  eraseAll();

  uint8_t v =
    readFlash(0x00, 0x00, 0x00);

  Serial.print(F("VERIFY = 0x"));
  printHex8(v);
  Serial.println();

  if (v == 0xFF)
    Serial.println(F("ERASE VERIFY: OK"));
  else
    Serial.println(F("ERASE VERIFY: FALLA"));

  exitLVP();
}

// ========================================================
// PROCESAR COMANDO
// ========================================================

void processCommand(char *cmd)
{
  while (*cmd == ' ')
    cmd++;

  // ------------------------------------------------------
  // T
  // ------------------------------------------------------

  if (cmd[0] == 'T' ||
      cmd[0] == 't')
  {
    test1234();
    return;
  }

  // ------------------------------------------------------
  // D
  // ------------------------------------------------------

  if (cmd[0] == 'D' ||
      cmd[0] == 'd')
  {
    commandDeviceID();
    return;
  }

  // ------------------------------------------------------
  // E
  // ------------------------------------------------------

  if (cmd[0] == 'E' ||
      cmd[0] == 'e')
  {
    commandErase();
    return;
  }

  // ------------------------------------------------------
  // W
  // ------------------------------------------------------

  if (cmd[0] == 'W' ||
      cmd[0] == 'w')
  {
    char *p = cmd + 1;

    while (*p == ' ')
      p++;

    // Necesitamos:
    // W 000000 1234

    if (strlen(p) < 11)
    {
      Serial.println(F("ERROR FORMATO"));
      Serial.println(F("USO: W 000000 1234"));
      return;
    }

    uint32_t address = hex24(p);

    while (*p && *p != ' ')
      p++;

    while (*p == ' ')
      p++;

    if (strlen(p) < 4)
    {
      Serial.println(F("ERROR DATO"));
      return;
    }

    uint16_t word =
      ((uint16_t)hexByte(p[0], p[1]) << 8) |
      hexByte(p[2], p[3]);

    writeCustom(address, word);

    return;
  }

  // ------------------------------------------------------
  // R
  // ------------------------------------------------------

  if (cmd[0] == 'R' ||
      cmd[0] == 'r')
  {
    char *p = cmd + 1;

    while (*p == ' ')
      p++;

    if (strlen(p) < 6)
    {
      Serial.println(F("ERROR FORMATO"));
      Serial.println(F("USO: R 000000"));
      return;
    }

    uint32_t address = hex24(p);

    readCustom(address);

    return;
  }

  Serial.println(F("COMANDO NO RECONOCIDO"));

  Serial.println(F("COMANDOS DISPONIBLES:"));
  Serial.println(F("T"));
  Serial.println(F("W 000000 1234"));
  Serial.println(F("R 000000"));
  Serial.println(F("D"));
  Serial.println(F("E"));
}

// ========================================================
// SETUP
// ========================================================

void setup()
{
  Serial.begin(115200);

  pinMode(PGC, OUTPUT);
  pinMode(PGD, OUTPUT);
  pinMode(PGM, OUTPUT);
  pinMode(MCLR, OUTPUT);

  digitalWrite(PGC, LOW);
  digitalWrite(PGD, LOW);
  digitalWrite(PGM, LOW);
  digitalWrite(MCLR, LOW);

  nullBuffer();

  Serial.println();
  Serial.println(F("=========================================="));
  Serial.println(F(" ARDUINO UNO -> PIC18F4550"));
  Serial.println(F(" PROGRAMADOR LVP V25"));
  Serial.println(F("=========================================="));

  Serial.println(F("D10 -> MCLR"));
  Serial.println(F("D11 -> PGD"));
  Serial.println(F("D12 -> PGC"));
  Serial.println(F("D13 -> PGM"));

  Serial.println();
  Serial.println(F("COMANDOS:"));
  Serial.println(F("T = prueba 0x1234"));
  Serial.println(F("W 000000 1234 = escribir"));
  Serial.println(F("R 000000 = leer"));
  Serial.println(F("D = Device ID"));
  Serial.println(F("E = Erase"));

  Serial.println();
  Serial.println(F("Arduino iniciado."));
  Serial.println(F("Velocidad Serial: 115200"));
  Serial.println();
  Serial.println(F("Escribe T para prueba."));
}

// ========================================================
// LOOP
// ========================================================

void loop()
{
  while (Serial.available())
  {
    char c = Serial.read();

    if (c == '\r' || c == '\n')
    {
      if (serialIndex > 0)
      {
        serialBuffer[serialIndex] = '\0';

        processCommand(serialBuffer);

        serialIndex = 0;
        serialBuffer[0] = '\0';

        Serial.println();
        Serial.println(F("Escribe comando:"));
      }
    }
    else
    {
      if (serialIndex < sizeof(serialBuffer) - 1)
      {
        serialBuffer[serialIndex++] = c;
      }
    }
  }
}
